# Server listen address:port (e.g. 0.0.0.0:10510 = listen on port 10510 on all interfaces)
LISTEN=0.0.0.0:10510

# Credentials for the SwitchBot official Cloud API (used to send commands to the Air Conditioner)
# How to obtain: SwitchBot app -> Profile -> Settings -> About (基本データ) -> tap the version number repeatedly -> Developer Options -> generate Token/Secret
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# Credentials for SwitchBot App Internal API (used to get realtime status of the Air Conditioner)
# 2FA Verification is not supported
# If passwordless account, create password in SwitchBot app -> Profile -> Account Settings -> Password
SWITCHBOT_EMAIL=
SWITCHBOT_PASSWORD=

# Device ID of the Air Conditioner (infrared remote)
# How to obtain: run `$ bun run devices` and find it in the listed devices
DEVICE_ID=
